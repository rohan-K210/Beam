# Copy to .env before running `docker compose up -d`.

# IP address TURN advertises in relay candidates.
#   127.0.0.1        -> tabs on the same machine (default)
#   your LAN IPv4    -> devices on the same LAN
#   your public IPv4 -> peers across the internet (open UDP 3478 and 49160-49200)
TURN_EXTERNAL_IP=127.0.0.1

# Long-term credentials. Keep these in sync with client/js/config.js.
TURN_USER=chat
TURN_PASS=chatpass
