# Beam environment
#
# Copy this file to .env and fill in the values you need.
# The server's .gitignore already excludes .env, so secrets here do not ship
# with the repository.
#
# Port and host
# --------------
# Render Free Web Service (and similar hosts) assign the port and expect
# the process to listen on 0.0.0.0. Leave PORT and HOST as defaults unless
# your host requires something else.
PORT=8080
HOST=0.0.0.0

# Signal server
# --------------
# If you are running locally with `npm start`, the defaults below are enough.
# For remote hosting you normally need the page to be served over a reachable
# URL (and WSS over HTTPS for cross-device testing).
# This app does not use a separate signaling URL env var; the page derives the
# signaling URL from the page's own origin by default, and you can override it
# per session with ?signal=<url>.

# TURN
# ----
# Leave these blank when you want STUN + direct WebRTC only.
#
# For a managed provider using static TURN credentials, the server uses these
# to answer /turn-credentials requests. Prefer Metered's credential API below
# for production instead of long-lived credentials.
#
# TURN_URLS can be one URL or a comma-separated list. The value is returned to
# the client as the ICE TURN urls. Use the same scheme/port the provider expects.
# Example patterns (replace with your provider's real values):
#   TURN_URLS=turn:your-provider.example.com:3478
#   TURN_URLS=turns:your-provider.example.com:5349,turn:your-provider.example.com:3478
#
# The client normalizes each URL once it receives it, so credentials can be kept
# in username/credential rather than embedded in the URL string.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Metered TURN credential API (recommended for production)
# ---------------------------------------------------------
# Get the app name and TURN credential API key from the Metered dashboard.
# These values are read only by the Node server and must never go in client code
# or a shareable URL. Leave both blank to use TURN_URLS above.
METERED_APP_NAME=
METERED_API_KEY=

# Local coturn (development only)
# --------------------------------
# When the page is opened on localhost, the client uses the local coturn service
# at turn:localhost:3478 with the development-only chat/chatpass credentials.
# Remote deployments never synthesize this local URL.
TURN_USER=chat
TURN_PASS=chatpass
# TURN_EXTERNAL_IP=
